{
  "name": "@silent-hawk/mongo-backup-cloud",
  "version": "0.2.0",
  "description": "Automated MongoDB backups to S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, Google Cloud Storage, Azure Blob Storage, Google Drive, Dropbox and local storage, with encryption, retention and scheduling.",
  "keywords": [
    "mongodb",
    "backup",
    "restore",
    "s3",
    "google-drive",
    "cloudflare-r2",
    "backblaze",
    "digitalocean-spaces",
    "google-cloud-storage",
    "azure-blob-storage",
    "dropbox",
    "mongodump",
    "mongorestore",
    "cron"
  ],
  "license": "MIT",
  "author": {
    "name": "Silent Hawk LDA",
    "url": "https://shwk.eu"
  },
  "maintainers": [
    {
      "name": "Silent Hawk LDA",
      "url": "https://shwk.eu"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silent-Hawk-LDA/mongo-backup-cloud.git"
  },
  "homepage": "https://github.com/Silent-Hawk-LDA/mongo-backup-cloud#readme",
  "bugs": {
    "url": "https://github.com/Silent-Hawk-LDA/mongo-backup-cloud/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mongo-backup-cloud": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm pack --dry-run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "node-cron": "^3.0.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@azure/storage-blob": "12.32.0",
    "@google-cloud/storage": "7.17.1",
    "dropbox": "10.34.0",
    "googleapis": "^140.0.1"
  },
  "overrides": {
    "@azure/core-rest-pipeline": "1.24.0",
    "@azure/core-util": "1.13.1",
    "@azure/core-client": "1.10.2",
    "@azure/core-xml": "1.5.1",
    "@azure/logger": "1.3.0",
    "@azure/core-auth": "1.10.1",
    "@azure/abort-controller": "2.1.2",
    "@azure/storage-common": "12.4.1",
    "@azure/core-http-compat": "2.3.2",
    "@azure/core-paging": "1.6.2",
    "@azure/core-tracing": "1.3.0",
    "@typespec/ts-http-runtime": "0.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
